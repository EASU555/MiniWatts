    "Paused" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停"
          }
        }
      }
    },
    "Last CPU sample interval" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次 CPU 采样间隔"
          }
        }
      }
    },
    "CPU sampling was interrupted. Waiting for the next adjacent sample." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 采样曾中断，正在等待下一次连续采样。"
          }
        }
      }
    },
    "CPU usage" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 占用率"
          }
        }
      }
    },
    "CPU icon" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU 图标"
          }
        }
      }
    },
    "Whole-device CPU" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整机 CPU"
          }
        }
      }
    },
    "No CPU reading yet. Two live samples are needed; if this persists, iOS is not providing CPU counters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时没有 CPU 读数。需要连续两次实时采样；如果持续没有读数，说明 iOS 未提供 CPU 计数。"
          }
        }
      }
    },
    "Average busy time across the device's CPU cores during the latest sample interval. This is not MiniWatts' own CPU use, CPU frequency, or power consumption." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近一次采样间隔内，整机各 CPU 核心的平均忙碌时间比例。它不是 MiniWatts 自身的 CPU 占用率、CPU 频率，也不是功耗。"
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定"
          }
        }
      }
    },
    "Problem report" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问题报告"
          }
        }
      }
    },
    "Key events are recorded locally while MiniWatts runs. The previous run is retained after reopening the app. Reports are only shared when you export them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniWatts 运行时会在本机记录关键事件，重新打开后仍保留上次运行记录。只有你主动导出，报告才会被分享。"
          }
        }
      }
    },
    "Mark problem time" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记问题发生时间"
          }
        }
      }
    },
    "Problem time marked" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
