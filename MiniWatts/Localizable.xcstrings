    "Unrecognised thermal state." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未识别的发热状态。"
          }
        }
      }
    },
    "USB-C" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
