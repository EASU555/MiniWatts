    "Picture in Picture was reset after iOS did not finish stopping it. You can start it again now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 未能完成画中画停止操作，MiniWatts 已将其重置。现在可以重新启动画中画。"
          }
        }
      }
    },
    "Select at least one item to display." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少选择一项显示内容。"
          }
        }
      }
    },
    "Picture in Picture is not supported on this device." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不支持画中画。"
          }
        }
      }
    },
    "Picture in Picture audio mode could not start." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画音频模式无法启动。"
          }
        }
      }
    },
    "Picture in Picture is not ready. Keep the preview visible and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画尚未就绪，请保持预览可见后重试。"
          }
        }
      }
    },
    "Picture in Picture could not start." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画无法启动。"
          }
        }
      }
    },
    "Picture in Picture could not enter the background automatically." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画中画无法自动转入后台。"
          }
        }
      }
    },
    "The floating monitor redraws once per second. Together shows power and temperatures at the same time; Separate pages alternates between them every four seconds." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬浮监视器每秒刷新一次。同屏模式同时显示功率和温度；分页轮播模式每四秒切换一次。"
          }
        }
      }
    },
    "The floating monitor redraws once per second. Choose all temperatures or one component; the iOS system thermal state is always shown. Together shows power and temperatures at the same time; Separate pages alternates between them every four seconds." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬浮监视器每秒刷新一次。温度可选择全部部件或单独一个部件，且始终显示 iOS 系统发热状态。同屏模式同时显示功率和温度；分页轮播模式每四秒切换一次。"
          }
        }
      }
    },
    "Start Picture in Picture here before leaving MiniWatts. Picture in Picture and Dynamic Island run independently, and sensor sampling stays active while either presentation is enabled." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开 MiniWatts 前请先在这里启动画中画。画中画和灵动岛相互独立运行；任一展示处于开启状态时，传感器都会持续采样。"
          }
        }
      }
    },
    "Select content in Settings" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中选择显示内容"
          }
        }
      }
    },
    "Not charging" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未在充电"
          }
        }
      }
    },
    "From wireless charger" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自无线充电器"
          }
        }
      }
    },
    "Charger" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电器"
          }
        }
      }
    },
    "Widgets read the sensors themselves whenever iOS refreshes them — usually every 15 to 60 minutes — and straight away when you plug in or unplug with MiniWatts open. Each one says when its numbers were taken." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小组件会在 iOS 刷新时自行读取传感器——通常每 15 到 60 分钟一次；MiniWatts 打开时插拔充电器会立即刷新。每个小组件都会注明数据的读取时间。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
